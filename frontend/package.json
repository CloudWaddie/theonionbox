{
  "name": "theonionbox-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Dashboard UI of The Onion Box. Builds into ../theonionbox/web (served by Bottle). Node is only needed to rebuild it.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
